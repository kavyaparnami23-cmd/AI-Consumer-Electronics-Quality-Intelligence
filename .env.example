# ── Backend Environment Variables ─────────────────────────────────────────────
# MLflow tracking URI (default: local SQLite file)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# API server settings
API_HOST=0.0.0.0
API_PORT=8000

# ── Frontend Environment Variables ────────────────────────────────────────────
# Set this ONLY when running the frontend standalone (not via Docker/nginx)
# Leave empty when using Docker — nginx proxy handles routing automatically
# VITE_API_BASE=http://localhost:8000
